{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "36leads",
  "version": "0.3.0",
  "description": "Find new customers: target companies and contacts with a business email and LinkedIn profile, through your 36leads account.",
  "author": {
    "name": "36leads",
    "url": "https://36leads.io"
  },
  "homepage": "https://36leads.io",
  "license": "UNLICENSED",
  "keywords": [
    "find-customers",
    "contact-search",
    "b2b",
    "sales"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "36leads",
        "shortDescription": "Find and verify new customers",
        "developerName": "36leads",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://36leads.io",
        "defaultPrompt": [
          "Use 36leads to find new customers for my offer.",
          "Use 36leads to find the right contacts at a company."
        ]
      }
    }
  }
}
