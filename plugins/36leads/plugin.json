  "license": "UNLICENSED",
  "keywords": ["kunden-finden", "kontaktsuche", "b2b", "sales"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "36leads",
        "shortDescription": "Neue Kunden finden und prüfen",
